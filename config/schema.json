{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Config key; must equal the file name."
    },
    "appName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60,
      "description": "Launcher label / window title."
    },
    "appId": {
      "type": "string",
      "description": "Android applicationId / Electron appId."
    },
    "url": {
      "description": "Start URL of a single-site app (legacy; normalized to one source). Use `sources` for several.",
      "type": "string",
      "format": "uri"
    },
    "sources": {
      "description": "Sources, in display order.",
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$",
            "description": "Stable source id."
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "description": "Display name (the only thing shown in the UI)."
          },
          "url": {
            "type": "string",
            "format": "uri",
            "description": "Start URL (never shown in the UI)."
          },
          "allowedHosts": {
            "description": "Default: URL host and its subdomains.",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "accent": {
            "description": "Accent colour; a palette colour is picked by index when missing.",
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "enabled": {
            "default": true,
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "name",
          "url"
        ],
        "additionalProperties": false
      }
    },
    "recommendedSource": {
      "description": "Id of the recommended source.",
      "type": "string"
    },
    "tagline": {
      "default": "",
      "description": "Shown on the splash.",
      "type": "string",
      "maxLength": 120
    },
    "credit": {
      "default": "",
      "description": "Author credit shown on the splash.",
      "type": "string",
      "maxLength": 60
    },
    "island": {
      "default": {
        "visibility": "home"
      },
      "type": "object",
      "properties": {
        "visibility": {
          "default": "home",
          "type": "string",
          "enum": [
            "home",
            "always"
          ]
        }
      },
      "additionalProperties": false
    },
    "remote": {
      "description": "Firebase Remote Config live config; omit to build without Firebase.",
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "const": "firebase-remote-config"
        },
        "projectId": {
          "type": "string",
          "minLength": 1
        },
        "parameter": {
          "default": "movy_config",
          "type": "string",
          "minLength": 1
        },
        "googleServices": {
          "type": "string",
          "minLength": 1,
          "description": "Path to google-services.json, relative to the repo root."
        },
        "template": {
          "description": "Path to the Remote Config JSON source.",
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "provider",
        "projectId",
        "googleServices"
      ],
      "additionalProperties": false
    },
    "version": {
      "default": "1.0.0",
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+([-+][0-9A-Za-z.-]+)?$"
    },
    "versionCode": {
      "default": 1,
      "type": "integer",
      "minimum": 1,
      "maximum": 2100000000
    },
    "allowedHosts": {
      "description": "Hosts allowed for in-app top-level navigation. Default: URL host and its subdomains.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "authHosts": {
      "description": "Extra sign-in hosts (added to the built-in list) that a user tap may open as a top-level navigation.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "externalLinks": {
      "default": "block",
      "description": "Non-allowed hosts: \"block\" (default, silently ignored) or \"in-app\". \"open-external\" is deprecated and treated as \"block\"; the app never launches other apps.",
      "type": "string",
      "enum": [
        "block",
        "in-app",
        "open-external"
      ]
    },
    "userAgent": {
      "default": null,
      "description": "null = platform default with WebView markers removed.",
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "backgroundColor": {
      "default": "#000000",
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "orientation": {
      "default": "any",
      "type": "string",
      "enum": [
        "any",
        "portrait",
        "landscape"
      ]
    },
    "adblock": {
      "default": {
        "enabled": true,
        "lists": "default",
        "extraLists": [],
        "customRules": [],
        "cosmetic": true,
        "blockPopups": true
      },
      "type": "object",
      "properties": {
        "enabled": {
          "default": true,
          "description": "Master switch for ad blocking.",
          "type": "boolean"
        },
        "lists": {
          "default": "default",
          "description": "\"default\" or an array of filter list URLs.",
          "anyOf": [
            {
              "type": "string",
              "const": "default"
            },
            {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "format": "uri"
              }
            }
          ]
        },
        "extraLists": {
          "default": [],
          "description": "Filter list URLs appended to `lists`.",
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          }
        },
        "customRules": {
          "default": [],
          "description": "Inline ABP/uBO filter rules.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cosmetic": {
          "default": true,
          "description": "Element hiding + scriptlets.",
          "type": "boolean"
        },
        "blockPopups": {
          "default": true,
          "description": "Block window.open / target=_blank to non-allowed hosts.",
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
